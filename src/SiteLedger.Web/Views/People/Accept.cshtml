@{ ViewData["Title"] = "Accept invitation"; }
<section class="auth"><p class="eyebrow">JOIN A WORKSPACE</p><h1>Accept invitation</h1><p class="muted">Enter the details in your invitation email.</p><div asp-validation-summary="All" class="error" role="alert"></div><form method="post"><label>Tenant ID <input name="tenantId" required /></label><label>Invitation ID <input name="invitationId" required /></label><label>Invitation token <input name="token" required /></label><label>Full name <input name="fullName" maxlength="200" required /></label><label>Password <input name="password" type="password" required autocomplete="new-password" /></label><button class="button">Join workspace</button></form></section>
