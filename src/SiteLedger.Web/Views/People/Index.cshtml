@model System.Text.Json.JsonElement[]
@{ ViewData["Title"] = "People"; }
<section class="heading"><div><p class="eyebrow">WORKSPACE ACCESS</p><h1>People</h1><p class="muted">Invite and manage users in your company.</p></div></section><div class="grid"><section class="card"><h2>Users</h2>@foreach(var item in Model){<article class="record"><b>@item.GetProperty("fullName").GetString()</b><p class="muted">@item.GetProperty("email").GetString() · @(item.GetProperty("isActive").GetBoolean() ? "Active" : "Inactive")</p><details><summary>Update access</summary><form asp-action="Update" method="post"><input type="hidden" name="id" value="@item.GetProperty("id").GetString()" /><label>Full name <input name="fullName" value="@item.GetProperty("fullName").GetString()" required /></label><label>Role <select name="role" required><option value="" disabled selected="@(item.GetProperty("role").ValueKind == System.Text.Json.JsonValueKind.Null)">Choose a role</option><option value="TenantAdmin" selected="@(item.GetProperty("role").GetString() == "TenantAdmin")">TenantAdmin</option><option value="Manager" selected="@(item.GetProperty("role").GetString() == "Manager")">Manager</option><option value="Member" selected="@(item.GetProperty("role").GetString() == "Member")">Member</option><option value="Viewer" selected="@(item.GetProperty("role").GetString() == "Viewer")">Viewer</option></select></label><label>Account status <select name="isActive"><option value="true" selected="@item.GetProperty("isActive").GetBoolean()">Active</option><option value="false" selected="@(!item.GetProperty("isActive").GetBoolean())">Inactive</option></select></label><button class="button">Save access</button></form></details></article>}</section><aside class="card"><h2>Invite a user</h2><form asp-action="Invite" method="post"><label>Email <input name="email" type="email" required /></label><label>Role <select name="role"><option>Member</option><option>Manager</option><option>Viewer</option><option>TenantAdmin</option></select></label><button class="button">Send invitation</button></form></aside></div>
