<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · SiteLedger</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header class="top"><div class="shell nav"><a class="brand" asp-controller="Home" asp-action="Index"><span>SL</span> SiteLedger</a><nav aria-label="Main navigation">@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Projects" asp-action="Index">Projects</a>@if (User.IsInRole("TenantAdmin")) { <a asp-controller="People" asp-action="Index">People</a><a asp-controller="Audit" asp-action="Index">Audit</a> }<a asp-controller="Account" asp-action="Security">Security</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="link" type="submit">Sign out</button></form> } else { <a asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-cta" asp-controller="Account" asp-action="Register">Get started</a> }</nav></div></header><main class="shell">@if (TempData["Message"] is string message) { <div class="notice" role="status">@message</div> } @RenderBody()</main><footer class="shell footer">SiteLedger · Keep your projects in view</footer>@await RenderSectionAsync("Scripts", required: false)</body></html>
