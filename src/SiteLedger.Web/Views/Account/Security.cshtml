@{ ViewData["Title"] = "Security"; }
<section class="auth"><p class="eyebrow">ACCOUNT SECURITY</p><h1>Authenticator</h1><p class="muted">Use an authenticator app to generate sign-in codes. Recovery codes are not available yet, so keep your authenticator secure.</p><div asp-validation-summary="All" class="error" role="alert"></div>@if (ViewBag.Key is string key) { <div class="notice"><strong>Authenticator key</strong><p>@key</p><p>Add this key to your authenticator app, then enter the code below to enable it.</p></div> }<form method="post"><label>Email <input type="email" name="email" value="@User.Identity?.Name" required /></label><label>Password <input type="password" name="password" required autocomplete="current-password" /></label><label>Authenticator code <input name="code" inputmode="numeric" autocomplete="one-time-code" /></label><div class="actions"><button class="button secondary" name="operation" value="setup">Get setup key</button><button class="button" name="operation" value="enable">Enable</button><button class="button secondary" name="operation" value="disable">Disable</button></div></form></section>
