@{ ViewData["Title"] = "Sign in"; }
<section class="auth"><p class="eyebrow">WELCOME BACK</p><h1>Sign in</h1><p class="muted">Continue to your project workspace.</p><div asp-validation-summary="All" class="error" role="alert"></div><form method="post"><label>Email <input type="email" name="email" required autocomplete="username" /></label><label>Password <input type="password" name="password" required autocomplete="current-password" /></label><label>Authenticator code <input name="authenticatorCode" inputmode="numeric" autocomplete="one-time-code" /><small>Enter a code if two-factor authentication is enabled.</small></label><label>Recovery code <input name="recoveryCode" autocomplete="off" /><small>Use a recovery code if you cannot access your authenticator.</small></label><button class="button" type="submit">Sign in</button></form><p><a asp-action="Recovery">Need help signing in?</a> · <a asp-action="Register">Create an account</a></p></section>
