@{ ViewData["Title"] = "Create account"; }
<section class="auth"><p class="eyebrow">GET STARTED</p><h1>Create your workspace</h1><p class="muted">Register your company and confirm your email to sign in.</p><div asp-validation-summary="All" class="error" role="alert"></div><form method="post"><label>Full name <input name="fullName" maxlength="200" required autocomplete="name" /></label><label>Company name <input name="companyName" maxlength="200" required /></label><label>Email <input name="email" type="email" maxlength="256" required autocomplete="email" /></label><label>Password <input name="password" type="password" required autocomplete="new-password" /></label><button class="button" type="submit">Create account</button></form><p>Already registered? <a asp-action="Login">Sign in</a></p></section>
