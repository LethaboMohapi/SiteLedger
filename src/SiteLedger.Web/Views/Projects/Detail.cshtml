@model System.Text.Json.JsonElement[]
@{ ViewData["Title"] = "Project"; Guid projectId = ViewBag.ProjectId; var reports = (System.Text.Json.JsonElement[])ViewBag.Reports; var expenses = (System.Text.Json.JsonElement[])ViewBag.Expenses; }
<a class="back" asp-action="Index">← All projects</a><section class="heading"><div><p class="eyebrow">PROJECT WORKSPACE</p><h1>Site activity</h1><p class="muted">Tasks, reports and expenses for this project.</p></div><div class="actions"><a class="button secondary" asp-controller="Files" asp-action="Index" asp-route-id="@projectId">Files</a>@if (User.IsInRole("TenantAdmin")) { <a class="button secondary" asp-action="Members" asp-route-id="@projectId">Manage members</a> }</div></section>
<div class="workspace"><section class="card"><div class="card-head"><h2>Tasks</h2><span class="count">@Model.Length</span></div>@foreach(var item in Model){<article class="record"><b>@item.GetProperty("title").GetString()</b><p class="muted">@item.GetProperty("percentComplete")% complete</p><details><summary>Edit task</summary><form asp-action="Task" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="version" value="@item.GetProperty("rowVersion")" /><label>Title <input name="title" value="@item.GetProperty("title").GetString()" required /></label><label>Description <textarea name="description">@item.GetProperty("description").GetString()</textarea></label><label>Due date <input type="date" name="dueDate" value="@(item.GetProperty("dueDate").ValueKind == System.Text.Json.JsonValueKind.Null ? "" : item.GetProperty("dueDate").GetString())" /></label><label>Priority <select name="priority">@for(int n=0;n<4;n++){<option value="@n" selected="@(item.GetProperty("priority").GetInt32() == n)">@(new[]{"Low","Medium","High","Critical"}[n])</option>}</select></label><label>Status <select name="status">@for(int n=0;n<4;n++){<option value="@n" selected="@(item.GetProperty("status").GetInt32() == n)">@(new[]{"To do","In progress","Blocked","Done"}[n])</option>}</select></label><label>Complete % <input type="number" name="percentComplete" min="0" max="100" value="@item.GetProperty("percentComplete")" /></label><button class="button">Save</button></form></details></article>}<details><summary>Add task</summary><form asp-action="Task" method="post"><input type="hidden" name="id" value="@projectId" /><label>Title <input name="title" required maxlength="200" /></label><label>Description <textarea name="description"></textarea></label><label>Due date <input name="dueDate" type="date" /></label><label>Priority <select name="priority"><option value="0">Low</option><option value="1">Medium</option><option value="2">High</option><option value="3">Critical</option></select></label><input type="hidden" name="status" value="0" /><input type="hidden" name="percentComplete" value="0" /><button class="button">Add task</button></form></details></section>
<section class="card"><div class="card-head"><h2>Site reports</h2><a asp-action="Export" asp-route-projectId="@projectId" asp-route-kind="reports">Export CSV</a><span class="count">@reports.Length</span></div>@foreach(var item in reports){<article class="record"><b>@item.GetProperty("reportDate") · @item.GetProperty("weather").GetString()</b><p>@item.GetProperty("workSummary").GetString()</p><p class="muted">Status: @(new[]{"Draft","Submitted","Approved","Rejected"}[item.GetProperty("status").GetInt32()])</p><form asp-action="Transition" method="post" class="actions"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="kind" value="reports" /><button class="button secondary" name="actionType" value="submit">Submit</button></form><details><summary>Edit report</summary><form asp-action="Report" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="version" value="@item.GetProperty("rowVersion")" /><label>Date <input type="date" name="reportDate" value="@item.GetProperty("reportDate")" required /></label><label>Weather <input name="weather" value="@item.GetProperty("weather").GetString()" required /></label><label>Workers <input type="number" name="workersOnSite" min="0" value="@item.GetProperty("workersOnSite")" /></label><label>Work summary <textarea name="workSummary" required>@item.GetProperty("workSummary").GetString()</textarea></label><label>Issues <textarea name="issues">@item.GetProperty("issues").GetString()</textarea></label><button class="button">Save</button></form></details><details><summary>Review report</summary><form asp-action="Transition" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="kind" value="reports" /><input type="hidden" name="actionType" value="review" /><label>Comment <input name="comment" required /></label><button class="button" name="approve" value="true">Approve</button><button class="button secondary" name="approve" value="false">Reject</button></form></details></article>}<details><summary>Add report</summary><form asp-action="Report" method="post"><input type="hidden" name="id" value="@projectId" /><label>Date <input type="date" name="reportDate" required /></label><label>Weather <input name="weather" required /></label><label>Workers on site <input type="number" name="workersOnSite" min="0" value="0" /></label><label>Work summary <textarea name="workSummary" required></textarea></label><label>Issues <textarea name="issues"></textarea></label><button class="button">Save draft</button></form></details></section>
<section class="card"><div class="card-head"><h2>Expenses</h2><a asp-action="Export" asp-route-projectId="@projectId" asp-route-kind="expenses">Export CSV</a><span class="count">@expenses.Length</span></div>@foreach(var item in expenses){<article class="record"><b>@item.GetProperty("supplier").GetString() · @item.GetProperty("amount")</b><p class="muted">@item.GetProperty("expenseDate") · Status: @(new[]{"Draft","Submitted","Approved","Rejected"}[item.GetProperty("status").GetInt32()])</p><form asp-action="Transition" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="kind" value="expenses" /><button class="button secondary" name="actionType" value="submit">Submit</button></form><details><summary>Edit expense</summary><form asp-action="Expense" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="version" value="@item.GetProperty("rowVersion")" /><label>Date <input name="expenseDate" type="date" value="@item.GetProperty("expenseDate")" required /></label><label>Category <select name="category">@for(int n=0;n<5;n++){<option value="@n" selected="@(item.GetProperty("category").GetInt32() == n)">@(new[]{"Materials","Labour","Equipment","Transport","Other"}[n])</option>}</select></label><label>Amount <input name="amount" type="number" min="0.01" step="0.01" value="@item.GetProperty("amount")" required /></label><label>Supplier <input name="supplier" value="@item.GetProperty("supplier").GetString()" required /></label><button class="button">Save</button></form></details><details><summary>Review expense</summary><form asp-action="Transition" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="itemId" value="@item.GetProperty("id")" /><input type="hidden" name="kind" value="expenses" /><input type="hidden" name="actionType" value="review" /><label>Comment <input name="comment" required /></label><button class="button" name="approve" value="true">Approve</button><button class="button secondary" name="approve" value="false">Reject</button></form></details></article>}<details><summary>Add expense</summary><form asp-action="Expense" method="post"><input type="hidden" name="id" value="@projectId" /><label>Date <input name="expenseDate" type="date" required /></label><label>Category <select name="category"><option value="0">Materials</option><option value="1">Labour</option><option value="2">Equipment</option><option value="3">Transport</option><option value="4">Other</option></select></label><label>Amount <input name="amount" type="number" min="0.01" step="0.01" required /></label><label>Supplier <input name="supplier" required /></label><button class="button">Save draft</button></form></details></section></div>
