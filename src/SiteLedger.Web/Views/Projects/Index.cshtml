@model System.Text.Json.JsonElement[]
@{ ViewData["Title"] = "Projects"; var page = (int?)(ViewBag.Page) ?? 1; var manager = User.IsInRole("TenantAdmin") || User.IsInRole("Manager"); }
<section class="heading"><div><p class="eyebrow">WORKSPACE</p><h1>Projects</h1><p class="muted">Your sites, in one place.</p></div>@if(manager) { <a class="button secondary" asp-action="Export">Export CSV</a> }</section>
@if (ViewBag.Dashboard is System.Text.Json.JsonElement dashboard) { <section class="stats" aria-label="Project overview"><div><span>Projects</span><strong>@dashboard.GetProperty("projects")</strong></div><div><span>Active projects</span><strong>@dashboard.GetProperty("activeProjects")</strong></div><div><span>Open tasks</span><strong>@dashboard.GetProperty("openTasks")</strong></div><div><span>Approved expenses</span><strong>@dashboard.GetProperty("approvedExpenses")</strong></div></section> }
@if (ViewBag.Error is string error) { <p class="error">@error</p> }
<div class="grid"><section><div class="card"><div class="card-head"><h2>Your projects</h2><span class="muted">Page @(page)</span></div>@if (Model.Length == 0) { <p class="muted">No projects on this page.</p> } else { @foreach (var item in Model) { <article class="project-row"><div><a class="project-link" asp-action="Detail" asp-route-id="@item.GetProperty("id").GetGuid()">@item.GetProperty("name").GetString()</a><p class="muted">@item.GetProperty("clientName").GetString() · @item.GetProperty("siteAddress").GetString()</p></div>@if(manager) { <form asp-action="DeleteProject" method="post"><input type="hidden" name="id" value="@item.GetProperty("id")" /><input type="hidden" name="version" value="@item.GetProperty("rowVersion")" /><button class="button secondary">Delete project</button></form><details><summary>Edit</summary><form asp-action="Update" method="post" class="compact"><input type="hidden" name="id" value="@item.GetProperty("id")" /><input type="hidden" name="version" value="@item.GetProperty("rowVersion")" /><label>Project <input name="name" value="@item.GetProperty("name").GetString()" required /></label><label>Client <input name="clientName" value="@item.GetProperty("clientName").GetString()" required /></label><label>Site address <input name="siteAddress" value="@item.GetProperty("siteAddress").GetString()" required /></label><label>Budget <input type="number" step="0.01" min="0" name="budget" value="@item.GetProperty("budget")" required /></label><label>Start <input type="date" name="startDate" value="@item.GetProperty("startDate")" required /></label><label>End <input type="date" name="endDate" value="@(item.GetProperty("endDate").ValueKind == System.Text.Json.JsonValueKind.Null ? "" : item.GetProperty("endDate").GetString())" /></label><label>Status <select name="status"><option value="0" selected="@(item.GetProperty("status").GetInt32() == 0)">Planning</option><option value="1" selected="@(item.GetProperty("status").GetInt32() == 1)">Active</option><option value="2" selected="@(item.GetProperty("status").GetInt32() == 2)">On hold</option><option value="3" selected="@(item.GetProperty("status").GetInt32() == 3)">Completed</option></select></label><button class="button">Save project</button></form></details> }</article> } }<div class="actions">@if (page > 1) { <a asp-action="Index" asp-route-page="@(page - 1)">Previous</a> } @if (Model.Length == 20) { <a asp-action="Index" asp-route-page="@(page + 1)">Next</a> }</div></div></section>@if(manager) { <aside><div class="card"><p class="eyebrow">NEW PROJECT</p><h2>Add a site</h2><form asp-action="Create" method="post"><label>Project name <input name="name" maxlength="200" required /></label><label>Client <input name="clientName" maxlength="200" required /></label><label>Site address <input name="siteAddress" maxlength="300" required /></label><label>Budget <input name="budget" type="number" min="0" step="0.01" value="0" required /></label><label>Start date <input name="startDate" type="date" required /></label><label>End date <input name="endDate" type="date" /></label><label>Status <select name="status"><option value="0">Planning</option><option value="1">Active</option><option value="2">On hold</option><option value="3">Completed</option></select></label><button class="button">Create project</button></form></div></aside> }</div>
