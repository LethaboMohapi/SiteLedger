@model System.Text.Json.JsonElement[]
@{ ViewData["Title"] = "Members"; Guid projectId = ViewBag.ProjectId; var users = (System.Text.Json.JsonElement[])ViewBag.Users; }
<a class="back" asp-action="Detail" asp-route-id="@projectId">← Project</a><section class="heading"><div><p class="eyebrow">PROJECT ACCESS</p><h1>Members</h1><p class="muted">Manage who can access this project.</p></div></section><div class="grid"><section class="card"><h2>Current members</h2>@foreach(var member in Model){<article class="project-row"><b>@member.GetProperty("fullName").GetString()</b><p class="muted">@member.GetProperty("email").GetString() · @member.GetProperty("roleOnProject").GetString()</p><form asp-action="Member" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="userId" value="@member.GetProperty("userId").GetString()" /><input type="hidden" name="remove" value="true" /><button class="button secondary">Remove</button></form></article>}</section><aside class="card"><h2>Add a member</h2><form asp-action="Member" method="post"><input type="hidden" name="id" value="@projectId" /><label>User <select name="userId" required>@foreach(var user in users){<option value="@user.GetProperty("id").GetString()">@user.GetProperty("fullName").GetString() · @user.GetProperty("email").GetString()</option>}</select></label><label>Project role <input name="roleOnProject" maxlength="100" required /></label><button class="button">Add member</button></form></aside></div>
