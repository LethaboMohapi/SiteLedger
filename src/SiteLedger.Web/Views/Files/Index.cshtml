@model System.Text.Json.JsonElement[]
@{ ViewData["Title"] = "Files"; Guid projectId = ViewBag.ProjectId; var manager = User.IsInRole("TenantAdmin") || User.IsInRole("Manager"); var writer = manager || User.IsInRole("Member"); }
<a class="back" asp-controller="Projects" asp-action="Detail" asp-route-id="@projectId">← Project</a><section class="heading"><div><p class="eyebrow">PROJECT FILES</p><h1>Files</h1><p class="muted">Private project documents and images.</p></div></section><div class="grid"><section class="card"><h2>Files</h2>@if(Model.Length == 0) { <p class="muted">No files available.</p> } @foreach(var item in Model){ <article class="record"><a asp-action="Download" asp-route-id="@projectId" asp-route-fileId="@item.GetProperty("id").GetGuid()">@item.GetProperty("fileName").GetString()</a><p class="muted">@item.GetProperty("sizeBytes") bytes · @(item.GetProperty("isSharedWithClient").GetBoolean() ? "Shared with viewers" : "Private")</p><div class="actions">@if(manager) { <form asp-action="Share" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="fileId" value="@item.GetProperty("id")" /><input type="hidden" name="shared" value="@(!item.GetProperty("isSharedWithClient").GetBoolean() ? "true" : "false")" /><button class="button secondary">@(item.GetProperty("isSharedWithClient").GetBoolean() ? "Stop sharing" : "Share with viewers")</button></form> }@if(writer) { <form asp-action="Delete" method="post"><input type="hidden" name="id" value="@projectId" /><input type="hidden" name="fileId" value="@item.GetProperty("id")" /><button class="button secondary">Delete</button></form> }</div></article> }</section>@if(writer) { <aside class="card"><h2>Upload a file</h2><p class="muted">PDF, PNG and JPEG files are accepted, subject to your plan limits.</p><form asp-action="Upload" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@projectId" /><label>File <input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg" required /></label><label>Category <select name="category"><option value="0">Photo</option><option value="1">Drawing</option><option value="2">Invoice</option><option value="3">Contract</option><option value="4">Report</option></select></label><button class="button">Upload</button></form></aside> }</div>
